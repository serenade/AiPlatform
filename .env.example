# LLM 接入（三者齐全自动启用真实模式；留空则 Mock 模式）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# auto(默认，无配置自动 Mock) | on | off
LLM_MOCK=auto

# 种子管理员
SEED_ADMIN_EMAIL=admin@air.local
SEED_ADMIN_PASSWORD=12345678

# 服务间内部令牌（api 与 agent-server 需一致）
INTERNAL_API_TOKEN=dev-internal-token

# 应用私有 SQLite 数据目录（默认 apps/api/appdata；docker 内为 /data/appdata）
# APP_DATA_DIR=
